# --- Content generation (pipeline/generate_content.py) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AGENT_NAME="Your Name Realty"
# Optional: path to a logo image relative to public/ (e.g. "logo.png" for a
# file at public/logo.png). Drop your logo file in public/ and set this to
# show it in the video header instead of the default gold house mark.
LOGO_SRC=

# --- B-roll (pipeline/fetch_broll.py) ---
# Free stock video/photo per segment via Pexels (https://www.pexels.com/api/).
# Optional — with no key, the video just uses the animated background only.
PEXELS_API_KEY=

# --- Text-to-speech (pipeline/generate_audio.py) ---
TTS_PROVIDER=elevenlabs

# elevenlabs provider
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# kokoro / kokoro-onnx providers (local, no API key needed)
KOKORO_VOICE=af_heart
# kokoro provider only (PyTorch, downloads weights from Hugging Face)
KOKORO_LANG_CODE=a
# kokoro-onnx provider only (ONNX Runtime, downloads weights from GitHub
# Releases into pipeline/models/ on first run — use this when huggingface.co
# isn't reachable from your network)
KOKORO_ONNX_LANG=en-us

# --- Rendering (orchestrator.sh) ---
# Only needed if your environment can't download Remotion's own Chrome
# Headless Shell (e.g. a network-restricted sandbox/CI runner). Point these
# at a Chrome/Chromium binary already on disk. Full Chrome builds only
# support the new headless mode, hence the paired chrome-mode setting.
REMOTION_BROWSER_EXECUTABLE=
REMOTION_CHROME_MODE=

# --- Instagram publishing (pipeline/post_to_instagram.py) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0
# Public URL of the rendered video, required unless you pass --video-url.
VIDEO_PUBLIC_URL=
